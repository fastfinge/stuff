HideFromSearchIndex: true
Excluded: => !Context.GetBool(WebKeys.GenerateSearchIndex)
ShowInNavbar: false
---
@*
  Local override of the theme's search page. The only change is the two script
  URLs below: the theme loads lunr and pako from jsdelivr and leaves it to
  MirrorResources to pull them local at build time, and MirrorResources is off
  because its HTML round-trip double-encodes entities in attributes. See
  settings.yml and input/js/vendor.

  Compare against theme/main/CleanBlog-main/input/search.cshtml before editing;
  everything else here is the theme's.
*@
<form>
  <div class="form-group">
    <label for="search">Search Query</label>
    <input class="form-control" type="search" aria-label="Search" id="search-query">
  </div>
</form>

<div id="search-results"></div>

@section Scripts
{
  <script src="/js/vendor/lunr.min.js"></script>
  <script src="/js/vendor/pako_inflate.min.js"></script>
  <script src='@(Context.GetLink(Context.GetPath(WebKeys.SearchScriptPath, "search.js")))'></script>
  <script>
    (function(search) {
      function runSearch() {
        var query = document.getElementById("search-query").value;
        document.getElementById("search-results").replaceChildren();
        if (query.length < 2)
        {
          return;
        }

        search.search(query, function(results) {
          var list = document.createElement("ul");
          if (results.length == 0)
          {
            const li = document.createElement("li");
            li.append("No results found");
            list.appendChild(li);
          }
          else
          {
            for (const res of results)
            {
              const li = document.createElement("li");
              const a = document.createElement("a");
              a.setAttribute("href", res.link);
              a.append(res.title);
              li.appendChild(a);
              list.appendChild(li);
            }
          }
          document.getElementById("search-results").appendChild(list);
        });
      }

      function initializeSearch() {
        var searchField = document.getElementById("search-query");
        searchField.addEventListener("input", runSearch);
        searchField.addEventListener("propertychange", runSearch);
        searchField.addEventListener("paste", runSearch);

        const urlParams = new URLSearchParams(window.location.search);
        const queryParam = urlParams.get("query");
        if (queryParam) {
          searchField.value = queryParam;
          runSearch();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener("DOMContentLoaded", initializeSearch);
      } else {
        initializeSearch();
      }
    })(search); // The search object is defined in search.js
  </script>
}
