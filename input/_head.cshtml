@* IndieWeb protocol discovery. Everything here is a <link rel>, which is how
   every IndieWeb protocol is found: a consumer fetches a page from this site and
   reads these to learn where to send things. See the IndieWeb section of
   README.md for what each one buys and what it deliberately leaves out. *@

@{
  // rel -> settings key. An empty or missing setting produces no link at all,
  // so a service can be dropped by deleting its line from settings.yml.
  var protocolLinks = new (string Rel, string Key)[]
  {
    // IndieAuth: delegated to indieauth.com, which signs people in as their own
    // domain by checking rel=me both ways. Modern clients look for a
    // rel=indieauth-metadata document first and fall back to these two; there is
    // no metadata document here because its issuer field has to name the
    // authorization server, and this site is not the authorization server.
    ("authorization_endpoint", "AuthorizationEndpoint"),
    ("token_endpoint", "TokenEndpoint"),

    // Webmention, plus the older Pingback for software that never learned it.
    ("webmention", "WebmentionEndpoint"),
    ("pingback", "PingbackEndpoint"),

    // WebSub: a subscriber holding nothing but this page's URL can still find
    // the hub. The feeds carry the same pair, added by WebSubLinks.cs.
    ("hub", "WebSubHub"),
  };
}

@foreach ((string rel, string key) in protocolLinks)
{
  string href = Context.GetString(key);
  if (!string.IsNullOrWhiteSpace(href))
  {
    <link rel="@rel" href="@href">
  }
}

@* rel=me, the whole basis of IndieAuth: these say the accounts are mine, and
   each one links back here to say this site is theirs. *@
@foreach (string me in Context.GetList<string>("RelMe") ?? Array.Empty<string>())
{
  <link rel="me" href="@me">
}

@* Authorship: a consumer that finds a post here follows this to the home page
   and reads the representative h-card in the footer. Posts also carry an
   explicit p-author, so this is the fallback rather than the only route. *@
<link rel="author" href='@Context.GetLink("/", true)'>

@* WebSub again: the topic URL a subscriber would hand to the hub for this page. *@
<link rel="self" href="@Document.GetLink(true)">

<meta name="generator" content="Statiq">

<script src="/js/webmention.min.js" async></script>
<script src="/js/parse.js"> </script>
<script src="/js/fragmention.js" defer></script>
