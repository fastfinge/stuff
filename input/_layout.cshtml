<!DOCTYPE html>
<html lang="en">
@{
  var isPost = Document.GetBool("IsPost") && !Document.GetBool("IsPostArchive");
  var isPage = Document.GetBool("IsPage");

  // An archive page -- the home page, /posts, or a tag -- is an h-feed whose
  // children are h-entry previews. Rather than flag each of those templates,
  // detect the shape: an archive is the only kind of page whose children are
  // posts. The tag index fails this test, correctly: it lists tags, not posts.
  var isFeed = !isPost && Document.GetChildren().Any(x => x.GetBool("IsPost"));

  // Both microformats roots have to open before the masthead, because the
  // masthead is where the name, summary, date and tags are. They are emitted as
  // raw strings because Razor requires balanced markup inside a code block and
  // these two tags are not balanced within one.
  var (rootTag, rootClass) = isPost ? ("article", "h-entry")
                           : isFeed ? ("div", "h-feed")
                           : (null, null);
}

<head>

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  @if(Document.ContainsKey(WebKeys.Description))
  {
    <meta name="description" content="@Document.GetString(WebKeys.Description)">
  }
  @if(Document.ContainsKey(WebKeys.Author))
  {
    <meta name="author" content="@Document.GetString(WebKeys.Author)">
  }

  <title>@Document.GetString("PageTitle")</title>

  <link rel="canonical" href='@(Document.GetString("Canonical") ?? Document.GetLink(true))'>

  @{
    @foreach (IDocument rssFeed in Outputs["**/*.rss"])
    {
      <link type="application/rss+xml" rel="alternate" title="@rssFeed.GetString(WebKeys.Title)" href="@rssFeed.GetLink()" />
    }
    @foreach (IDocument atomFeed in Outputs["**/*.atom"])
    {
      <link type="application/atom+xml" rel="alternate" title="@atomFeed.GetString(WebKeys.Title)" href="@atomFeed.GetLink()" />
    }
  }

  <meta name="application-name" content='@Document.GetString("SiteTitle")' />
  <meta name="msapplication-tooltip" content='@Document.GetString("SiteTitle")' />
  <meta name="msapplication-starturl" content='@Context.GetLink("/")' />

  @* Open Graph. Beyond the social previews, these are what metaformats parsing
     falls back to when a consumer finds no microformats -- so og:type has to
     tell the truth about whether this page is an article. *@
  <meta property="og:title" content='@Document.GetString("PageTitle")' />
  @if (Document.ContainsKey(WebKeys.Description))
  {
    <meta property="og:description" content='@Document.GetString(WebKeys.Description)' />
  }
  @if (Document.ContainsKey(WebKeys.Image))
  {
    <meta property="og:image" content='@Context.GetLink(Document.GetString(WebKeys.Image))' />
  }
  <meta property="og:type" content='@(isPost ? "article" : "website")' />
  <meta property="og:url" content='@Document.GetLink(true)' />
  <meta property="og:site_name" content='@Document.GetString("SiteTitle")' />
  @if (isPost)
  {
    <meta property="article:published_time" content='@Document.GetDateTime(WebKeys.Published).ToString("yyyy-MM-ddTHH:mm:ssK")' />
    @if (Document.ContainsKey(WebKeys.Author))
    {
      <meta property="article:author" content='@Document.GetString(WebKeys.Author)' />
    }
    @foreach (string tag in Document.GetList<string>("Tags") ?? Array.Empty<string>())
    {
      <meta property="article:tag" content="@tag" />
    }
  }

  <link rel="icon" href='@Context.GetLink("/favicon.ico")'>

  <!-- Custom fonts for this template -->
  <link href='@Context.GetLink("/vendor/fontawesome-free/css/all.min.css")' rel="stylesheet">
  <link href="/js/font1.css" rel="stylesheet">
  <link href="/js/font2.css" rel="stylesheet">

  <!-- Styles for this template (also includes Bootstrap) -->
  <link href='@Context.GetLink("/scss/clean-blog.css")' rel="stylesheet">

  @* Served from here rather than from jsdelivr. The theme points these at the
     CDN and relies on MirrorResources to pull them local at build time, but that
     module round-trips every page through an HTML parser and the round-trip
     double-encodes entities in attributes -- turning a & in a link into &amp;,
     and Sam's into Sam&#x27;s in the og: tags. Vendoring the files means
     MirrorResources has nothing to rewrite and can stay off. See input/js/vendor. *@
  <script src="/js/vendor/prism-core.min.js"></script>
  @* data-autoloader-path is Prism's own way of being told where the language
     grammars live. Without it the autoloader guesses from its own script URL and
     would look in /js/vendor/components/, which is not where they are. It fetches
     one grammar per language actually used on the page, so nothing is downloaded
     for a page with no code on it. *@
  <script src="/js/vendor/prism-autoloader.min.js" data-autoloader-path="/js/vendor/prism-components/"></script>
  <script src="/js/vendor/quicklink.umd.js"></script>
  <link href="/js/vendor/prism.css" rel="stylesheet">

  @Html.Partial("_head")

  @RenderSection("Head", false)

</head>

<body>

  <!-- Navigation -->
  @RenderSectionOrPartial("Navigation", "_navigation")

  @if (rootTag != null)
  {
    @Html.Raw($"<{rootTag} class=\"{rootClass}\">")
  }

  <!-- Page Header -->
  @RenderSectionOrPartial("Header", "_header")

  <!-- Main Content -->
  <div class="container">
    <div class="row">
      <div id="content" class="col-md-12" role="main">
        @* e-content is the post body only. It deliberately excludes the
           syndication links below it, which are about the post rather than
           part of it. *@
        @if (isPost)
        {
          @Html.Raw("<div class=\"e-content\">")
        }
        @RenderBody()
        @if (isPost)
        {
          @Html.Raw("</div>")
        }
        @if (isPost)
        {
          @Html.Partial("_post-after-content")
        }
        else if (isPage)
        {
          @Html.Partial("_page-after-content")
        }
        @Html.Partial("_common-after-content")
      </div>
    </div>
  </div>

  @if (rootTag != null)
  {
    @Html.Raw($"</{rootTag}>")
  }

  @* Comments sit outside the h-entry on purpose. They are other people's posts
     replying to this one; inside the entry a parser would read them as this
     post's own content. They get their own container so the h-entry closes
     without leaving an element open across it. *@
  @if (isPost)
  {
    <div class="container">
      @Html.Partial("_post-comments")
    </div>
  }

  <hr>
<div role="contentinfo">
  <!-- Footer -->
  @RenderSectionOrPartial("Footer", "_footer")
</div>
  <!-- Scripts -->
  <script src='@Context.GetLink("/vendor/bootstrap/js/bootstrap.bundle.min.js")'></script>
  <script src='@Context.GetLink("/vendor/startbootstrap-clean-blog/js/scripts.js")'></script>
  <script src='@Context.GetLink("/js/clean-blog.js")'></script>
  @Html.Partial("_scripts")
  @RenderSection("Scripts", false)

</body>

</html>
